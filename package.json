{
  "name": "chabbs-resort",
  "private": true,
  "version": "2.0.0",
  "description": "CHABBS Resort & Conference Centre — Management System",
  "author": "CHABBS Resort & Conference Centre <info@chabbs.co.ke>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite --port 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:pack": "vite build && electron-builder --win --x64 --dir",
    "electron:installer": "makensis installer.nsi",
    "dist": "npm run electron:pack && npm run electron:installer"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "vite": "^6.0.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "ke.co.chabbs.resort",
    "productName": "CHABBS Resort Management",
    "copyright": "Copyright © 2025 CHABBS Resort & Conference Centre",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CHABBS Resort"
    }
  }
}
